#version 460
// Stage::Order: the order and its counters, or on the last frame the finish order and defeat reasons. One race per invocation.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#define STATE_BINDING 0
#define PARAMS_BINDING 1
#include "exact.glsl"
#include "race_state.glsl"
#include "sort.glsl"
#include "order.glsl"
#include "finish.glsl"

layout(local_size_x = 64) in;
layout(push_constant) uniform Push { uint lanes; float dt; } pc;

void main() {
    st_lane = gl_GlobalInvocationID.x;
    if (st_lane >= pc.lanes) return;
    st_lanes = pc.lanes;
    if (r_race_done()) return;  // the race ended in an earlier step
    if (r_frame_all_finished()) finish_frame();
    else calc_horse_order(pc.dt);
}
