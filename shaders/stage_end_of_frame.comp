#version 460
// Stage::EndOfFrame without the pre-July-2026 pacemaker. One race per invocation.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#define STATE_BINDING 0
#define PARAMS_BINDING 1
#include "exact.glsl"
#include "race_state.glsl"
#include "sort.glsl"
#include "queries.glsl"
#include "skill_layout.glsl"
#include "skill_state.glsl"
#include "end_of_frame.glsl"

layout(local_size_x = 64) in;
layout(push_constant) uniform Push { uint lanes; float dt; } pc;

void main() {
    st_lane = gl_GlobalInvocationID.x;
    if (st_lane >= pc.lanes) return;
    st_lanes = pc.lanes;
    if (r_race_done()) return;  // the race ended in an earlier step
    end_of_frame(pc.dt);
}
