#version 460
// gpu_mathcheck: one call site of Mathf.Pow / Mathf.Log10 for f32 stats first, first + stride, ... (by bit pattern).
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "exact.glsl"
#include "transcend.glsl"

layout(local_size_x = 64) in;
layout(std430, binding = 0) writeonly buffer Out { uint outv[]; };
// site 0: Pow(c * s, y); 1: Log10(s * c); 2: Log10(Pow((float)((double)s * c + 1), 2)) (temptation.rs)
layout(push_constant) uniform Push { uint first; uint count; uint stride; uint site; float c; float y; } pc;

const uint FAULT = 0x7FC0DEADu;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    float s = uintBitsToFloat(pc.first + i * pc.stride);
    float r;
    if (pc.site == 0u) r = mathf_pow(pc.c * s, pc.y);
    else if (pc.site == 1u) r = mathf_log10(s * pc.c);
    else {
        float x = float(double(s) * double(pc.c) + 1.0lf);
        r = mathf_log10(mathf_pow2(x));
    }
    outv[i] = transcend_fault ? FAULT : floatBitsToUint(r);
}
